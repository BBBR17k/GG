-- 5. ระบบ ESP แบบใหม่ (Box สี่เหลี่ยม + เส้น Tracer + หลอดเลือด) เสถียรไม่เอ๋อ
-- ==========================================
local ESPCache = {}

local function createPlayerESP(targetPlayer)
	if targetPlayer == player or ESPCache[targetPlayer] then return end

	-- กรอบสี่เหลี่ยม 2D รอบตัวละคร (Box ESP)
	local box = Instance.new("Frame")
	box.Name = targetPlayer.Name .. "_Box"
	box.BackgroundTransparency = 1
	box.BorderSizePixel = 0
	box.Visible = false
	box.ZIndex = 2
	box.Parent = espFolder

	local boxStroke = Instance.new("UIStroke")
	boxStroke.Color = Color3.fromRGB(0, 220, 255)
	boxStroke.Thickness = 1.6
	boxStroke.Parent = box

	local boxCorner = Instance.new("UICorner")
	boxCorner.CornerRadius = UDim.new(0, 3)
	boxCorner.Parent = box

	-- เส้นลากจากล่างจอไปยังตัวละคร (Tracer Line ESP)
	local line = Instance.new("Frame")
	line.Name = targetPlayer.Name .. "_Tracer"
	line.AnchorPoint = Vector2.new(0.5, 0.5)
	line.BackgroundColor3 = Color3.fromRGB(0, 220, 255)
	line.BorderSizePixel = 0
	line.Visible = false
	line.ZIndex = 2
	line.Parent = espFolder

	ESPCache[targetPlayer] = {
		Box = box,
		Tracer = line
	}
end

local function removePlayerESP(targetPlayer)
	local data = ESPCache[targetPlayer]
	if data then
		if data.Box then data.Box:Destroy() end
		if data.Tracer then data.Tracer:Destroy() end
		ESPCache[targetPlayer] = nil
	end
end

Players.PlayerRemoving:Connect(removePlayerESP)

local function updateAllESP()
	local viewportSize = camera.ViewportSize
	local originPoint = Vector2.new(viewportSize.X / 2, viewportSize.Y) -- จุดเริ่มต้นเส้นจากกึ่งกลางขอบล่างจอ

	for _, targetPlayer in ipairs(Players:GetPlayers()) do
		if targetPlayer ~= player then
			if not ESPCache[targetPlayer] then
				createPlayerESP(targetPlayer)
			end

			local espData = ESPCache[targetPlayer]
			local char = targetPlayer.Character
			local humanoid = char and char:FindFirstChildOfClass("Humanoid")
			local rootPart = char and char:FindFirstChild("HumanoidRootPart")
			local head = char and char:FindFirstChild("Head")

			if char and humanoid and humanoid.Health > 0 and rootPart and head then
				local rootPos, onScreen = camera:WorldToViewportPoint(rootPart.Position)

				-- อัปเดตตำแหน่ง Box และ Tracer เมื่อตัวละครอยู่ในหน้าจอ
				if onScreen and rootPos.Z > 0 then
					local topWorld = head.Position + Vector3.new(0, 1.1, 0)
					local bottomWorld = rootPart.Position - Vector3.new(0, 3.0, 0)

					local topScreen = camera:WorldToViewportPoint(topWorld)
					local bottomScreen = camera:WorldToViewportPoint(bottomWorld)

					local boxHeight = math.max(math.abs(bottomScreen.Y - topScreen.Y), 12)
					local boxWidth = boxHeight * 0.58

					-- 1. กรอบสี่เหลี่ยมรอบตัวผู้เล่น (Box ESP)
					if Config.BoxESPEnabled then
						espData.Box.Size = UDim2.new(0, boxWidth, 0, boxHeight)
						espData.Box.Position = UDim2.new(0, rootPos.X - (boxWidth / 2), 0, topScreen.Y)
						espData.Box.Visible = true
					else
						espData.Box.Visible = false
					end

					-- 2. เส้นลากไปยังผู้เล่น (Tracer ESP)
					if Config.TracerESPEnabled then
						local targetPoint = Vector2.new(rootPos.X, bottomScreen.Y)
						local distance = (targetPoint - originPoint).Magnitude
						local midPoint = (originPoint + targetPoint) / 2
						local angle = math.deg(math.atan2(targetPoint.Y - originPoint.Y, targetPoint.X - originPoint.X))

						espData.Tracer.Size = UDim2.new(0, distance, 0, 1.5)
						espData.Tracer.Position = UDim2.new(0, midPoint.X, 0, midPoint.Y)
						espData.Tracer.Rotation = angle
						espData.Tracer.Visible = true
					else
						espData.Tracer.Visible = false
					end
				else
					espData.Box.Visible = false
					espData.Tracer.Visible = false
				end

				-- 3. หลอดเลือดบนหัว (Health Bar)
				local hpGui = head:FindFirstChild("M7_HealthBar")
				if Config.HealthBarEnabled then
					if not hpGui then
						hpGui = Instance.new("BillboardGui")
						hpGui.Name = "M7_HealthBar"
						hpGui.Size = UDim2.new(0, 60, 0, 8)
						hpGui.StudsOffset = Vector3.new(0, 2.2, 0)
						hpGui.AlwaysOnTop = true
						hpGui.Parent = head

						local bg = Instance.new("Frame")
						bg.Name = "BG"
						bg.Size = UDim2.new(1, 0, 1, 0)
						bg.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
						bg.BorderSizePixel = 0
						bg.Parent = hpGui

						local bgCorner = Instance.new("UICorner")
						bgCorner.CornerRadius = UDim.new(1, 0)
						bgCorner.Parent = bg

						local bar = Instance.new("Frame")
						bar.Name = "Bar"
						bar.Size = UDim2.new(1, 0, 1, 0)
						bar.BackgroundColor3 = Color3.fromRGB(60, 235, 115)
						bar.BorderSizePixel = 0
						bar.Parent = bg

						local barCorner = Instance.new("UICorner")
						barCorner.CornerRadius = UDim.new(1, 0)
						barCorner.Parent = bar
					end

					local bar = hpGui.BG:FindFirstChild("Bar")
					if bar then
						local hpRatio = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
						bar.Size = UDim2.new(hpRatio, 0, 1, 0)
						bar.BackgroundColor3 = Color3.fromHSV(hpRatio * 0.33, 0.85, 0.95)
					end
				elseif hpGui then
					hpGui:Destroy()
				end
			else
				espData.Box.Visible = false
				espData.Tracer.Visible = false
				if head then
					local hpGui = head:FindFirstChild("M7_HealthBar")
					if hpGui then hpGui:Destroy() end
				end
			end
		end
	end
end

-- ==========================================
-- 6. ระบบตรวจสอบสิ่งกีดขวาง (Raycast) และ ล็อคเป้าหมาย
-- ==========================================
local function isTargetVisible(targetPart, targetCharacter)
	if not Config.WallCheck then
		return true
	end

	local origin = camera.CFrame.Position
	local direction = targetPart.Position - origin

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = {player.Character, camera}

	local result = Workspace:Raycast(origin, direction, rayParams)
	if result then
		return result.Instance:IsDescendantOf(targetCharacter)
	end
	return true
end

local function getClosestTargetInFOV()
	local closestPart = nil
	local shortestDistance = Config.FOVRadius
	local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)

	for _, targetPlayer in ipairs(Players:GetPlayers()) do
		if targetPlayer ~= player and targetPlayer.Character then
			local humanoid = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
			local targetPart = targetPlayer.Character:FindFirstChild("Head") or targetPlayer.Character:FindFirstChild("HumanoidRootPart")

			if humanoid and humanoid.Health > 0 and targetPart then
				local screenPos, onScreen = camera:WorldToViewportPoint(targetPart.Position)
				if onScreen and screenPos.Z > 0 then
					local distance = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
					if distance <= shortestDistance and isTargetVisible(targetPart, targetPlayer.Character) then
						shortestDistance = distance
						closestPart = targetPart
					end
				end
			end
		end
	end
	return closestPart
end

-- ==========================================
-- 7. ระบบเคลื่อนที่ M7 SPEED BOOST + HIGH JUMP
-- ==========================================
local function getHumanoid()
	local character = player.Character
	if not character then return nil end
	return character:FindFirstChildOfClass("Humanoid")
end

local function updateMovement()
	local humanoid = getHumanoid()
	if not humanoid then return end

	humanoid.WalkSpeed = M7Movement.SpeedEnabled
		and M7Movement.WalkSpeed
		or NORMAL_SPEED

	humanoid.UseJumpPower = true
	humanoid.JumpPower = M7Movement.JumpEnabled
		and M7Movement.JumpPower
		or NORMAL_JUMP
end

player.CharacterAdded:Connect(function(character)
	character:WaitForChild("Humanoid")
	task.wait(0.2)
	updateMovement()
end)

-- อัปเดตการทำงานหลักทุกเฟรม
RunService.RenderStepped:Connect(function()
	if Config.TargetLockEnabled then
		local target = getClosestTargetInFOV()
		if target then
			local targetCFrame = CFrame.new(camera.CFrame.Position, target.Position)
			camera.CFrame = camera.CFrame:Lerp(targetCFrame, Config.LockSpeed)
		end
	end
	updateAllESP()
end)

